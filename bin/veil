#!/usr/bin/env python3
"""Veil CLI launcher for standalone Linux installs.

CLI implementation is intentionally maintained only in veil.command, so the
standalone app and wheel entry points always run the same code.
"""
import os
import sys

project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if project_root not in sys.path:
    sys.path.insert(0, project_root)

from veil.command import main

if __name__ == "__main__":
    sys.exit(main())
