{
  "manifest_version": 3,
  "name": "Veil Privacy Companion",
  "version": "1.0",
  "description": "Local-first browser visibility control for Linux desktops.",
  "key": "",
  "permissions": [
    "bookmarks",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "veil-worker.js"
  },
  "action": {
    "default_title": "Veil Privacy Companion"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
