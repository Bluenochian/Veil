include LICENSE README.md CONTRIBUTING.md SECURITY.md SUPPORT.md DATA_LICENSE.md THIRD_PARTY_NOTICES.md
recursive-include docs *.md
recursive-include veil/data *.db
recursive-include assets *.png *.svg
recursive-include browser-extension *.js *.json *.png *.css *.html *.svg
recursive-include scripts *.sh
recursive-include packaging *
recursive-include debian *
recursive-include tests *.py *.cjs
prune build
prune dist
